# Configuración del frontend. Copia este archivo a .env y rellénalo.
#
# Estas dos variables NO son secretos: la publishable key va incrustada en el
# bundle del navegador y es pública por diseño. Lo que protege los datos es el
# RLS de la base de datos (supabase/migrations/20260928_0002_karvatech_rls.sql).
# Nunca pongas aquí la service_role key: esa sí es secreta y solo va en las
# variables de las Edge Functions.

VITE_SUPABASE_URL=https://zjbdqrolffzufjtnewtd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PQ6HRa3XslgsjN3W-luU6w_AOUPklUN

# Cloudinary (opcional). Si defines cloud name + upload preset "Unsigned", las
# imágenes de los proyectos se suben a Cloudinary; si no, se usa Supabase Storage.
VITE_CLOUDINARY_CLOUD_NAME=dyxf6yb4b
VITE_CLOUDINARY_UPLOAD_PRESET=
